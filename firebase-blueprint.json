{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with automotive job preferences and notification settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "major": { "type": "string", "maxLength": 100 },
        "skills": { "type": "string", "maxLength": 500 },
        "roles": { "type": "string", "maxLength": 500 },
        "regions": { "type": "string", "maxLength": 500 },
        "emailNotifications": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "major", "skills", "roles", "regions"]
    },
    "UserJobData": {
      "title": "UserJobData",
      "description": "User specific status, favorite mark, and notes for a job",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 50 },
        "isFavorite": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["jobId", "userId", "status", "isFavorite"]
    },
    "UserEvent": {
      "title": "UserEvent",
      "description": "Recruitment milestone event like exam, interview, or final announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "integer" },
        "date": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "maxLength": 50 },
        "memo": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "jobId", "date", "type"]
    },
    "PublicJob": {
      "title": "PublicJob",
      "description": "Automotive recruitment job listing collected from Saramin or system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "region": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "deadline": { "type": "string", "maxLength": 30 },
        "url": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 5000 },
        "source": { "type": "string", "maxLength": 50 },
        "skills": { "type": "array" },
        "majors": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "company", "title", "region", "deadline"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Structured candidate resume with versioning and consent",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "version": { "type": "string", "maxLength": 50 },
        "filePath": { "type": "string", "maxLength": 500 },
        "structuredData": { "type": "object" },
        "consentGiven": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "version", "consentGiven", "createdAt"]
    },
    "AcceptedProfile": {
      "title": "AcceptedProfile",
      "description": "Verified successful applicant profile with consent status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 200 },
        "jobCategory": { "type": "string", "maxLength": 100 },
        "hiringYear": { "type": "string", "maxLength": 50 },
        "qualifications": { "type": "array" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "source": { "type": "string", "maxLength": 200 },
        "permissionStatus": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "companyName", "jobCategory", "permissionStatus", "source"]
    },
    "ResumeAnalysis": {
      "title": "ResumeAnalysis",
      "description": "AI analysis result comparing resume against job requirements and accepted profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "resumeId": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "integer" },
        "companyName": { "type": "string", "maxLength": 200 },
        "jobTitle": { "type": "string", "maxLength": 200 },
        "requirementMatchScore": { "type": "integer" },
        "acceptedProfileSimilarity": { "type": "integer" },
        "sampleCount": { "type": "integer" },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "recommendations": { "type": "array" },
        "rationale": { "type": "string", "maxLength": 3000 },
        "analysisVersion": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "resumeId", "jobId", "requirementMatchScore", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities.UserProfile" },
      "description": "User profile preferences"
    },
    "/users/{userId}/jobData/{jobId}": {
      "schema": { "$ref": "entities.UserJobData" },
      "description": "User status and notes for a job"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "entities.UserEvent" },
      "description": "User recruitment timeline milestones"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": { "$ref": "entities.Resume" },
      "description": "User stored resume versions and structured data"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": { "$ref": "entities.ResumeAnalysis" },
      "description": "User resume competitiveness analysis history"
    },
    "/accepted_profiles/{profileId}": {
      "schema": { "$ref": "entities.AcceptedProfile" },
      "description": "Verified successful applicant profiles repository"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "entities.PublicJob" },
      "description": "Aggregated automotive jobs cache"
    }
  }
}
